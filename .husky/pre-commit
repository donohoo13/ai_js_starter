# .husky/pre-commit
# NUL-delimited so filenames with spaces, globs (*), or leading dashes are
# passed verbatim; -r skips prettier entirely on a deletion-only commit and
# -- stops prettier parsing any filename as a flag.

git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r pnpm exec prettier --write --ignore-unknown --
git update-index --again
