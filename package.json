{
  "name": "ai_starter",
  "version": "2.3.0",
  "description": "Opinionated AI-first starter template: Claude Code process suite on a pnpm + Turborepo monorepo skeleton",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "preinstall": "node scripts/setup/check-install.mjs",
    "prepare": "husky; bash scripts/setup/doctor.sh || true",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "husky": "9.1.7",
    "prettier": "^3.8.4",
    "turbo": "^2.5.0"
  }
}
