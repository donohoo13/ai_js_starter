{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "mcp__context7__*",
      "mcp__playwright-local__*",
      "mcp__chrome_devtools__*",
      "mcp__linear__*"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Read(./.*.vars)",
      "Read(./**/.*.vars)",
      "Read(~/.ssh/**)",
      "Read(**/secrets/**)",
      "Bash(git push -u origin main)",
      "Bash(git push main)"
    ],
    "ask": ["Bash(git push)", "Bash(git reset --hard*)", "Bash(docker *)", "WebFetch"],
    "defaultMode": "default"
  },
  "enableAllProjectMcpServers": true,
  "hooks": {},
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "linear@claude-plugins-official": true
  }
}
