{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false
  },
  "enableAllProjectMcpServers": true,
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "hooks": {},
  "claudeMdExcludes": [],
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "mcp__plugin_context7_context7__*",
      "mcp__playwright-local__*",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__*",
      "mcp__plugin_linear_linear__*"
    ],
    "ask": ["Bash(git*--force)", "Bash(git reset --hard*)", "Bash(docker *)", "WebFetch"],
    "deny": [
      "Read(**/.env.{local,development,production,staging})",
      "Read(**/.*.vars)",
      "Read(**/secrets/**)",
      "Read(**/.ssh/**)",
      "Bash(git push* main)",
      "Bash(git push* main *)",
      "Bash(git push*:main)",
      "Bash(git push*:main *)",
      "Bash(git push* +main*)",
      "Bash(git push*/main)",
      "Bash(git push*/main *)",
      "Bash(npx*)",
      "Bash(pnpm dlx*)",
      "Bash(clerk*)",
      "Bash(*wrangler*)",
      "Bash(*deploy*)"
    ],
    "defaultMode": "default"
  }
}
